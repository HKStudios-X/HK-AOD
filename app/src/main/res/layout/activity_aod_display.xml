<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <!-- Digital Clock (Only Time) -->
    <TextClock
        android:id="@+id/aodClock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:format12Hour="hh:mm"
        android:textColor="#FFFFFF"
        android:textSize="80sp"
        android:fontFamily="sans-serif-black" />

    <!-- Manual AM/PM TextView -->
    <TextView
        android:id="@+id/ampmText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/aodClock"
        android:layout_alignBaseline="@id/aodClock"
        android:layout_marginStart="5dp"
        android:text="--"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:fontFamily="sans-serif-black" />

    <!-- Real-time Battery Percentage -->
    <TextView
        android:id="@+id/batteryText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/aodClock"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"
        android:text="--%"
        android:textColor="#AAAAAA"
        android:textSize="18sp"
        android:fontFamily="sans-serif-black"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="30dp"
        android:text="#Vaa Maamey"
        android:textColor="#A4A2A2"
        android:textSize="14sp"
        android:fontFamily="sans-serif-black"/>

</RelativeLayout>